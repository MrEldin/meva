# The storefront and the API live on different subdomains in production, so
# the client calls the API by its absolute URL (in development Vite proxies
# /api instead, keeping the browser on one origin).
VITE_API_URL=https://api.meva.life/api

# Measurement. Leave a value empty and that tool is simply not loaded; both wait
# for the visitor's consent either way.
VITE_GA_ID=
VITE_PIXEL_ID=
